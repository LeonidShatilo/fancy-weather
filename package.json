{
  "name": "fancy-weather",
  "version": "1.1.0",
  "description": "Fancy Weather App",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "dev": "cross-env NODE_ENV=development webpack --mode development",
    "prettier": "prettier --config .prettierrc **/*.{js,scss,html} --write",
    "start": "cross-env NODE_ENV=development webpack serve --mode development --open",
    "watch": "cross-env NODE_ENV=development webpack --mode development --watch",
    "upgrade_packages": "yarn upgrade --latest --exact"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonidShatilo/fancy-weather.git"
  },
  "keywords": [
    "html",
    "sass",
    "js",
    "webpack"
  ],
  "author": "Leonid Shatilo <shatiloleonid@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LeonidShatilo/fancy-weather/issues"
  },
  "homepage": "https://github.com/LeonidShatilo/fancy-weather#readme",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "7.28.4",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "7.28.3",
    "babel-loader": "10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "13.0.1",
    "cross-env": "10.1.0",
    "css-loader": "7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "9.38.0",
    "eslint-webpack-plugin": "5.0.2",
    "globals": "15.8.0",
    "html-loader": "5.1.0",
    "html-webpack-plugin": "5.6.4",
    "mini-css-extract-plugin": "2.9.4",
    "prettier": "3.6.2",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.93.2",
    "sass-loader": "16.0.5",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.3.14",
    "webpack": "5.102.1",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.2"
  },
  "dependencies": {
    "axios": "1.12.2",
    "dotenv-webpack": "8.1.1",
    "normalize.css": "^8.0.1"
  }
}
