{
  "name": "fancy-weather",
  "version": "1.1.0",
  "description": "Fancy Weather App",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "dev": "cross-env NODE_ENV=development webpack --mode development",
    "netlify": "netlify dev",
    "prettier": "prettier --config .prettierrc **/*.{js,scss,html} --write",
    "start": "cross-env NODE_ENV=development webpack serve --mode development",
    "upgrade_packages": "yarn upgrade --latest --exact",
    "watch": "cross-env NODE_ENV=development webpack --mode development --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeonidShatilo/fancy-weather.git"
  },
  "keywords": [
    "html",
    "sass",
    "js",
    "webpack"
  ],
  "author": "Leonid Shatilo <shatiloleonid@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LeonidShatilo/fancy-weather/issues"
  },
  "homepage": "https://github.com/LeonidShatilo/fancy-weather#readme",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "eslint": "^9.39.2",
    "eslint-webpack-plugin": "^5.0.2",
    "globals": "^16.5.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.5",
    "mini-css-extract-plugin": "^2.9.4",
    "netlify-cli": "^23.12.3",
    "prettier": "^3.7.4",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.97.0",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "webpack": "^5.104.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "axios": "^1.13.2",
