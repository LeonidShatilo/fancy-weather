#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

if [[ -n "${NO_COLOR:-}" ]] || [[ "${TERM:-}" == "dumb" ]]; then
  RED="" GREEN="" BLUE="" NC=""
fi

repo_root=$(git rev-parse --show-toplevel)

echo -e "${BLUE}Running eslint...${NC}"

if ! (cd "${repo_root}" && npx eslint .); then
  echo -e "${RED}❌ COMMIT BLOCKED: eslint failed.${NC}" >&2
  echo "ACTION: Run 'npx eslint . --fix' and re-stage." >&2
  exit 1
fi

echo -e "${GREEN}✅ eslint clean.${NC}"
